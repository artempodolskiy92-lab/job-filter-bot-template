# Telegram (my.telegram.org -> API development tools)
TG_API_ID=
TG_API_HASH=
# Generated once via a local interactive login — see README "Setup" step 4.
# Not a .session file: this must be a Telethon StringSession so the bot can
# run headlessly in GitHub Actions without an interactive login prompt.
TG_SESSION_STRING=

# OpenRouter (openrouter.ai/keys)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.5-flash-lite

# Name of the Telegram folder (as shown in the app) that groups the vacancy
# channels/groups you want scanned. This is the only source of truth for
# what gets scanned — there is no separate channel list.
FOLDER_NAME=

# Comma-separated keywords for the cheap Stage-1 pre-filter (case-insensitive
# substring match). Keep this to role/title words, not format words like
# "remote" — main.py already treats a hardcoded set of format/geography
# words as context-only so they don't trigger every post in a channel.
KEYWORDS=business analyst,project manager,delivery manager,implementation consultant

# How far back to look, in hours
LOOKBACK_HOURS=24

# Below this remaining OpenRouter balance ($), the bot prepends a warning to
# its daily message instead of failing silently when credits run out.
OPENROUTER_LOW_BALANCE_THRESHOLD=2
